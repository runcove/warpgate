#!/usr/bin/env bash
# A stub `docker` for testing hardened-run.sh's real (non-dry) code path --
# the branch the shipped test suite's HARDENED_RUN_DRY/HARDENED_RUN_FAKE_INSPECT
# hooks never reach. Controlled entirely by env vars so a test can make any of
# `docker run` / `docker inspect` / `docker exec` succeed, fail, or return
# whatever value is under test, with no real container runtime involved.
#
# Recognised env vars:
#   STUB_DOCKER_RUN_RC       exit code for `docker run`        (default 0)
#   STUB_DOCKER_INSPECT_RC   exit code for `docker inspect`    (default 0)
#   STUB_DOCKER_MEM          value to print for a Memory inspect
#   STUB_DOCKER_NANOCPUS     value to print for a NanoCpus inspect
#   STUB_DOCKER_EXEC_RC      exit code for `docker exec`       (default 0)
#   STUB_DOCKER_EXEC_MARKER  if set, `docker exec` touches this path -- a test
#                            asserts its absence to prove the command never ran
#   STUB_DOCKER_RUN_ARGS_FILE   if set, the full `docker run` argument list
#                                (one per line) is written there -- a test
#                                asserts which `-e VAR` flags actually reached
#                                the call, not just that the script claims to.
#   STUB_DOCKER_EXEC_ARGS_FILE  same, for `docker exec` (the caller's real
#                                command only -- see below).
#   STUB_DOCKER_CP_RC        exit code for `docker cp`          (default 0)
#   STUB_DOCKER_EXEC_MKDIR_RC  exit code when the exec'd command is `mkdir`
#                                (hardened-run.sh's --source delivery step)
#   STUB_DOCKER_EXEC_TEST_RC   exit code when the exec'd command is `test`
#                                (the --verify-file check)
#   STUB_DOCKER_EXEC_FIND_RC     exit code when the exec'd command is `find`
#                                (the weaker, no-`--verify-file` check)
#   STUB_DOCKER_EXEC_FIND_OUTPUT  if set, printed as that `find`'s stdout --
#                                unset/empty means an empty workdir listing.
#
# `docker exec` is called four different ways by hardened-run.sh once
# --source is in play: the mkdir, the --verify-file `test`, the weaker
# `find`, and finally the caller's own real command. This stub tells them
# apart by scanning for the literal verb (mkdir/test/find) among the args --
# crude, but sufficient for a test double, and safe because no existing or
# new test here ever uses "mkdir", "test", or "find" as ITS OWN real command
# (all use "true"). Only the last of the four -- the caller's real command --
# touches STUB_DOCKER_EXEC_MARKER / STUB_DOCKER_EXEC_ARGS_FILE / the plain
# STUB_DOCKER_EXEC_RC, exactly as before this stub knew about --source.
set -uo pipefail

cmd="${1:-}"
case "$cmd" in
  run)
    if [ -n "${STUB_DOCKER_RUN_ARGS_FILE:-}" ]; then
      printf '%s\n' "$@" > "$STUB_DOCKER_RUN_ARGS_FILE"
    fi
    exit "${STUB_DOCKER_RUN_RC:-0}"
    ;;
  inspect)
    fmt="${3:-}"
    rc="${STUB_DOCKER_INSPECT_RC:-0}"
    if [ "$rc" -ne 0 ]; then
      echo "stub docker: inspect failed (STUB_DOCKER_INSPECT_RC=$rc)" >&2
      exit "$rc"
    fi
    case "$fmt" in
      *NanoCpus*) echo "${STUB_DOCKER_NANOCPUS:-}" ;;
      *Memory*)   echo "${STUB_DOCKER_MEM:-}" ;;
      *)          echo "" ;;
    esac
    exit 0
    ;;
  cp)
    exit "${STUB_DOCKER_CP_RC:-0}"
    ;;
  exec)
    # The script runs several execs of its OWN before and after the caller's
    # command -- mkdir/test/find to prepare and verify the workdir, and `cat` to
    # read the cgroup's peak-memory file afterwards. None of them is the
    # caller's real argv, and STUB_DOCKER_EXEC_ARGS_FILE is written with `>`, so
    # letting one through means the LAST internal exec overwrites the recording
    # and every assertion about the real command inspects the wrong invocation.
    #
    # `cat` was added 2026-09-19 with the peak-memory read, and it broke the
    # forwarded-env assertions exactly that way: they reported that docker exec
    # never received -e FORWARD_ME, which was a true statement about a probe and
    # a false one about the command under test.
    is_mkdir=0 is_test=0 is_find=0 is_cat=0
    for a in "$@"; do
      case "$a" in
        mkdir) is_mkdir=1 ;;
        test)  is_test=1 ;;
        find)  is_find=1 ;;
        cat)   is_cat=1 ;;
      esac
    done
    if [ "$is_cat" -eq 1 ]; then
      # Empty by default: no peak reading available, which is the path
      # hardened-run.sh must report as MEM-PEAK-UNAVAILABLE rather than pass
      # over in silence. Set STUB_DOCKER_EXEC_CAT_OUTPUT to supply a value.
      if [ -n "${STUB_DOCKER_EXEC_CAT_OUTPUT:-}" ]; then
        printf '%s\n' "$STUB_DOCKER_EXEC_CAT_OUTPUT"
      fi
      exit "${STUB_DOCKER_EXEC_CAT_RC:-0}"
    fi
    if [ "$is_mkdir" -eq 1 ]; then
      exit "${STUB_DOCKER_EXEC_MKDIR_RC:-0}"
    fi
    if [ "$is_test" -eq 1 ]; then
      exit "${STUB_DOCKER_EXEC_TEST_RC:-0}"
    fi
    if [ "$is_find" -eq 1 ]; then
      if [ -n "${STUB_DOCKER_EXEC_FIND_OUTPUT:-}" ]; then
        printf '%s\n' "$STUB_DOCKER_EXEC_FIND_OUTPUT"
      fi
      exit "${STUB_DOCKER_EXEC_FIND_RC:-0}"
    fi
    if [ -n "${STUB_DOCKER_EXEC_MARKER:-}" ]; then
      touch "$STUB_DOCKER_EXEC_MARKER"
    fi
    if [ -n "${STUB_DOCKER_EXEC_ARGS_FILE:-}" ]; then
      printf '%s\n' "$@" > "$STUB_DOCKER_EXEC_ARGS_FILE"
    fi
    exit "${STUB_DOCKER_EXEC_RC:-0}"
    ;;
  rm)
    exit 0
    ;;
  *)
    echo "stub docker: unhandled subcommand '$cmd'" >&2
    exit 1
    ;;
esac
