{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Our work lives on the cove-patches line, not on main (a stale upstream mirror). A new version-line changes baseBranchPatterns. Patch bundles are merged by the fork's CI check once green; minor and major updates wait for review.",
  "baseBranchPatterns": [
    "cove-patches-v0.29.1"
  ],
  "enabledManagers": [
    "cargo",
    "npm",
    "dockerfile"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/tests/**",
    "docker/Dockerfile",
    "helm/**",
    "**/node_modules/**"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "Rust patch updates",
      "description": "One weekly bundle per ecosystem and update type: patch bundles can be merged on green CI, minor bundles wait for review."
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Rust minor updates"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "web patch updates"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "web minor updates"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "container image patch updates"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "container image minor updates"
    },
    {
      "description": "Majors get their own PR, so a big jump never hides in a weekly bundle.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Patch updates wait 3 days after release as a supply-chain guard, and are marked for the CI check's merge step. Renovate itself never automerges.",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "addLabels": [
        "patch-bundle"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "labels": [
      "renovate",
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true
}
